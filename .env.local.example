# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://hodqpckslglxuyhitlgh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Apple Wallet (when ready)
# APPLE_PASS_TYPE_ID=pass.app.bigbamboo.loyalty
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_PASS_CERT_PATH=./certs/pass.p12
# APPLE_PASS_CERT_PASSWORD=your_cert_password
# APPLE_WWDR_CERT_PATH=./certs/wwdr.pem

# Google Wallet (when ready)
# GOOGLE_APPLICATION_CREDENTIALS=./certs/google-service-account.json
# GOOGLE_WALLET_ISSUER_ID=your_issuer_id

# ── Jukebox ─────────────────────────────────────
# Spotify (Phase 1: Client Credentials only; Phase 2 also uses these for OAuth)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://admin.bigbamboo.app/api/admin/jukebox/provider/spotify/callback

# App — used server-side to build the QR code URL on the display page.
APP_BASE_URL=https://jukebox.bigbamboo.app

# Public base — exposed to the admin client so the "copy display URL" button
# always shows the friendly subdomain link, regardless of where staff is browsing.
NEXT_PUBLIC_JUKEBOX_PUBLIC_URL=https://jukebox.bigbamboo.app

# Venue lookup (slug in the venues table)
JUKEBOX_DEFAULT_VENUE_SLUG=bigbamboo

# Generate each of these with: openssl rand -hex 32
JUKEBOX_IP_SALT=
JUKEBOX_TOKEN_KEY=
JUKEBOX_COOKIE_SECRET=
JUKEBOX_CRON_SECRET=
